<?xml version="1.0"?>
<launch>
  <!-- Launch the controller node -->
  <node pkg="prius_controller" type="prius_controller_node" name="prius_controller_node" output="screen">
    <!-- Basic parameters -->
    <param name="max_steering_angle" value="0.7" />
    <param name="max_velocity" value="5.0" />
    <param name="throttle_gain" value="0.5" />
    <param name="brake_gain" value="0.5" />
    
    <!-- Advanced control parameters -->
    <param name="min_velocity" value="0.1" />
    <param name="speed_error_tolerance" value="0.1" />
    <param name="steering_deadband" value="0.01" />
    <param name="throttle_deadband" value="0.05" />
    <param name="brake_deadband" value="0.05" />
  </node>
</launch> 