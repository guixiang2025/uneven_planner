<?xml version="1.0"?>
<launch>
  <!-- Arguments -->
  <arg name="map_name" default="hill" />
  <arg name="gui" default="true"/>
  <arg name="rviz" default="true"/>
  <arg name="prius_model" default="$(find prius_scaled_description)/urdf/prius_scaled.urdf" />
  <arg name="x_pos" default="0.0"/>
  <arg name="y_pos" default="0.0"/>
  <arg name="z_pos" default="2.0"/>
  <arg name="Y_pos" default="0.0"/>

  <!-- Load parameters for uneven_planner -->
  <rosparam command="load" file="$(find plan_manager)/params/run_$(arg map_name).yaml" />

  <!-- Launch the uneven_planner manager node -->
  <node pkg="plan_manager" name="manager_node" type="manager_node" output="screen">
    <param name="uneven_map/map_pcd" type="string" value="/home/grey/catkin_ws/src/uneven_planner/src/uneven_planner/uneven_map/maps/$(arg map_name).pcd" />
    <param name="uneven_map/map_file" type="string" value="/home/grey/catkin_ws/src/uneven_planner/src/uneven_planner/uneven_map/maps/$(arg map_name).map" />
    <remap from="~cmd" to="/racebot/cmd_vel"/>
    <remap from="~odom" to="/prius/base_pose_ground_truth"/>
    <remap from="~traj" to="/ugv/trajectory"/>
    <remap from="odom" to="/prius/base_pose_ground_truth"/>
  </node>

  <!-- Launch Gazebo with the specified world -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="verbose" value="true" />
    <arg name="world_name" value="/home/grey/catkin_ws/src/uneven_planner/src/carsim/worlds/map_$(arg map_name).world"/> 
    <arg name="gui" value="$(arg gui)" />
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="physics" value="ode"/>
  </include>

  <!-- Load the scaled Prius model description -->
  <param name="robot_description" textfile="$(arg prius_model)" />
  
  <!-- Spawn the scaled Prius model in Gazebo -->
  <node name="spawn_urdf" pkg="gazebo_ros" type="spawn_model"
        args="-param robot_description -urdf -x $(arg x_pos) -y $(arg y_pos) -z $(arg z_pos) -Y $(arg Y_pos) -model prius_scaled -robot_namespace /prius" />
  
  <!-- Robot state publisher for tf -->
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher">
    <param name="publish_frequency" value="50.0" />
    <param name="use_tf_static" value="true" />
    <param name="ignore_timestamp" value="true" />
    <remap from="joint_states" to="/prius/joint_states" />
  </node>
  
  <!-- Model TF Publisher for ground truth -->
  <node pkg="prius_scaled_controller" type="model_tf_publisher.py" name="model_tf_publisher" output="screen" />
  
  <!-- Static transform for map to odom -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="map_to_odom_broadcaster" 
        args="0 0 0 0 0 0 map odom" />
  
  <!-- Static transform for map to world -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="map_to_world_broadcaster" 
        args="0 0 0 0 0 0 map world" />
  
  <!-- Static transform for odometry - REMOVED: Conflicts with fake_localization dynamic TF -->
  <!-- <node pkg="tf2_ros" type="static_transform_publisher" name="odom_broadcaster" 
        args="0 0 0 0 0 0 odom base_link" /> -->

  <!-- Launch the scaled Prius controller -->
  <node pkg="prius_scaled_controller" type="prius_scaled_controller_node" name="prius_scaled_controller" output="screen">
    <param name="max_velocity" value="1.0" />
    <param name="max_steering_angle" value="0.7" />
    <param name="throttle_gain" value="0.7" />
    <param name="brake_gain" value="0.7" />
  </node>
  
  <!-- Launch RViz if requested -->
  <group if="$(arg rviz)">
    <node name="rviz" pkg="rviz" type="rviz" 
          args="-d /home/grey/catkin_ws/src/uneven_planner/prius_integration/prius_scaled_description/rviz/prius_scaled.rviz" required="true" />
  </group>
</launch>