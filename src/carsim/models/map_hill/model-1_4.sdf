<?xml version="1.0"?>
<sdf version="1.4">
  <model name="map_hill">
    <static>true</static>
    <link name="map_link">
      <pose>0 0 0 0 0 0</pose>
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://map_hill/meshes/map_hill.dae</uri>
            <scale>1.0 1.0 1.0</scale>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>1e3</kd>
              <max_vel>10.0</max_vel>
              <min_depth>0.005</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://map_hill/meshes/map_hill.dae</uri>
            <scale>1.0 1.0 1.0</scale>
          </mesh>
        </geometry>
        <material>
          <script>
            <uri>model://map_hill/materials/scripts/map.material</uri>
            <uri>model://map_hill/materials/textures/texture.jpg</uri>
            <name>map_hill/Image</name>
          </script>
        </material>
      </visual>

    </link>


  </model>
</sdf>
